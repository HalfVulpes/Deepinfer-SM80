# DeepInfer-SM80 build image (NVIDIA Ampere / SM80).
#
# Bakes: CUDA 13.0 devel + Python 3.12 + GCC 13, the exact vLLM base commit the
# patches target, both patches applied, and an editable build restricted to
# TORCH_CUDA_ARCH_LIST="8.0 8.6" so Hopper/Blackwell-only extension targets are
# skipped by vLLM's CMake arch filtering.
#
# Verified end-to-end on an A100-SXM4-80GB host (16 cores, ~35 min build):
# verify_env.py passes and all three microbenchmarks run in the image
# (see docs/REPRODUCTION.md).
#
# Build:
#   docker build -f docker/Dockerfile.sm80 -t deepinfer-sm80:cu130 .
# Smoke test (one GPU):
#   docker run --rm --gpus all deepinfer-sm80:cu130 python scripts/verify_env.py

ARG CUDA_VERSION=13.0.0
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# vLLM PR #56201 commit that both patches are based on.
ARG VLLM_BASE_COMMIT=79a7108d9aea27ddab99ce1779290d300b17fc23
# 8.0 = A100/A800, 8.6 = RTX 3090 / RTX A6000.
ARG TORCH_CUDA_ARCH_LIST="8.0 8.6"
# Parallel compile jobs for the vLLM extension build.
ARG MAX_JOBS=16
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gcc-13 \
        g++-13 \
        libnuma-dev \
        python3.12 \
        python3.12-dev \
        python3.12-venv \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100 \
    && rm -rf /var/lib/apt/lists/*

RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/local/nvidia/bin:$PATH
ENV VIRTUAL_ENV=/opt/venv

RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir cmake ninja "setuptools-scm>=8" packaging \
    && pip install --no-cache-dir torch==2.13.0 \
        --index-url https://download.pytorch.org/whl/cu130

WORKDIR /workspace
COPY . /workspace/Deepinfer-SM80

# The base commit only lives on the (closed) PR #56201 ref, which a plain
# `git clone` does not fetch.
RUN git init -q /workspace/vllm \
    && git -C /workspace/vllm remote add origin https://github.com/vllm-project/vllm.git \
    && git -C /workspace/vllm fetch -q --filter=blob:none --no-tags origin refs/pull/56201/head \
    && git -C /workspace/vllm checkout -q "${VLLM_BASE_COMMIT}"

RUN bash /workspace/Deepinfer-SM80/scripts/apply_patches.sh --vllm-dir /workspace/vllm

# Ampere-only build: the Hopper/Blackwell-only extensions (_vllm_fa3_C,
# _flashmla_C, _deep_gemm_C, fmha_sm100, ...) are optional in setup.py and are
# skipped when the arch list contains no sm_90a / sm_100a.
ENV TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST}
ENV MAX_JOBS=${MAX_JOBS}
RUN cd /workspace/vllm \
    && pip install --no-cache-dir -r requirements/build/cuda.txt \
    && pip install --no-cache-dir -e . --no-build-isolation

WORKDIR /workspace/Deepinfer-SM80
CMD ["python", "scripts/verify_env.py"]
