+    """indptr[i] = sum(lengths[:i]) for i in [0, num_rows], in one launch."""
+    offsets = tl.arange(0, BLOCK)
+    # Shift by one so the inclusive scan yields the exclusive prefix sum:
+    # slot 0 contributes nothing, slot i+1 contributes lengths[i].
+    prev = tl.load(
+        lengths_ptr + offsets - 1,
+        mask=(offsets >= 1) & (offsets <= num_rows),
+        other=0,
+    ).to(tl.int32)
